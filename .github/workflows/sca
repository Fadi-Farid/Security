name: 'Trivy SCA Scan dispatch'
on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  trivy-sca:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read
      security-events: write
    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Run Trivy SCA Scan Action
        id: trivy
        uses: ./.github/actions/trivy-sca   
        with:
          scanners: "vuln"
          severity: "HIGH,CRITICAL"

            
      - name: Upload SARIF as artifact
        uses: actions/upload-artifact@v4
        with:
          name: trivy-sarif
          path: trivy-results.txt

