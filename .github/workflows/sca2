name: Trivy SCA2 Scan

on:
  push:
    branches: [ "**" ]
  pull_request:

permissions:
  contents: read
  security-events: write   # required to upload SARIF to Code Scanning
  actions: read

jobs:
  trivy-sca:
    name: Run Trivy SCA (dependencies)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      # (Optional) Cache for faster scans when using SBOM or large repos
      - name: Setup cache
        uses: actions/cache@v4
        with:
          path: ~/.cache/trivy
          key: trivy-cache-${{ runner.os }}-${{ hashFiles('**/package-lock.json', '**/yarn.lock', '**/poetry.lock', '**/requirements.txt', '**/go.sum', '**/pom.xml', '**/Cargo.lock', '**/Gemfile.lock') }}
          restore-keys: |
            trivy-cache-${{ runner.os }}-

      # SCA: Scan repository (VCS mode) to detect dependency files across the repo
      # Alternatives:
      #   scan-type: "fs" with 'path: .' if you prefer filesystem scanning
      - name: Run Trivy SCA (VCS mode)
        id: trivy
        uses: aquasecurity/trivy-action@v0.20.0
        with:
          scan-type: "repo"            # "repo" (VCS) or "fs"
          ignore-unfixed: true         # ignore issues without available fixes
          vuln-type: "library"         # SCA (library dependencies)
          format: "sarif"              # output SARIF for Code Scanning
          output: "trivy-results.sarif"
          severity: "CRITICAL,HIGH"    # choose: UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL
          exit-code: "1"               # fail job if findings meet severity filter
          # Optional: customize categories visible in Code Scanning UI
          # github-pat: ${{ secrets.GITHUB_TOKEN }} # default is sufficient
          # trivy-config: ".trivyignore"            # if you use a .trivyignore file
          # scanners: "vuln,secret,license"         # add 'license' if you also want license issues
          # timeout: "10m"

      # Upload SARIF to GitHub Code Scanning
      - name: Upload SARIF to Code Scanning
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: trivy-results.sarif
          category: trivy-sca

      # Also keep a downloadable artifact of the SARIF in the workflow run
      - name: Upload SARIF as artifact
        uses: actions/upload-artifact@v4
        with:
          name: trivy-sarif
          path: trivy-results.sarif
          if-no-files-found: error
